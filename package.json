{
  "name": "toolbox",
  "productName": "ToolBox",
  "version": "0.7.0",
  "description": "Pon tu Windows a punto: limpieza, instalación de apps y ajustes, explicados paso a paso.",
  "main": "src/main.js",
  "author": "chismeh32-jpg",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:windows": "node test/windows-smoke.js",
    "test:repairs": "node test/windows-repairs.js",
    "test:bloat": "node test/windows-bloat.js",
    "test:uninstall": "node test/windows-uninstall.js",
    "test:graphics": "node test/windows-graphics.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.chismeh32.toolbox",
    "productName": "ToolBox",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "native/bin", "to": "bin", "filter": ["*.exe", "*.txt"] }],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "ToolBox-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ToolBox-Portable-${version}.${ext}"
    }
  }
}
